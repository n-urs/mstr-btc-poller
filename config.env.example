# MSTR BTC Poller — example config.
# Copy this to `config.env` (same folder as mstr_btc_poller.py) and fill in your
# own values. `config.env` is gitignored — never commit real secrets.
# Lines starting with `#` are comments. CLI flags and env vars override these.

# REQUIRED: SEC requires a real User-Agent with contact info. Use YOUR email —
# SEC rate-limits / blocks generic UAs.
SEC_UA=your-name your-email@example.com

# Polling interval in seconds. 0.20 = ~5 req/sec, well under SEC's 10/sec limit.
# 0.10 = the 10/sec ceiling. Don't go faster.
INTERVAL=0.20

# Which SEC feed to poll:
#   submissions = per-CIK JSON at data.sec.gov (1 fetch per filing, never misses)
#   getcurrent  = global latest-filings Atom feed (often lower latency, 2 fetches
#                 per filing, small risk of overflow during heavy filing bursts)
#   both        = poll both concurrently; whichever spots a new filing first
#                 wins (exactly one alert). Each feed polls at half the
#                 configured rate so the total SEC request budget is unchanged.
#                 Also self-heals when one feed host is slow or throttled.
FEED=both

# Open each new 8-K in your default browser as soon as it's detected (1/true/yes).
OPEN_IN_BROWSER=true

# With OPEN_IN_BROWSER on, only open BTC-update filings (skip ATM share-sale etc).
OPEN_ONLY_BTC=false

## Health monitoring
# Fire one "degraded" alert after this many consecutive poll failures.
HEALTH_FAIL_THRESHOLD=5
# Log a heartbeat line every N seconds so silence (= dead process) is visible.
HEARTBEAT_SECS=300

# Set to true to silence audible beep alerts.
NO_AUDIBLE=false

# OPTIONAL: LLM second-opinion via Groq (Llama 3.3 70B). Get a free key at
# https://console.groq.com/keys . If set, every BTC update is independently
# checked for sale disclosure. Leave blank to disable.
GROQ_API_KEY=
# Max seconds to wait for the LLM response (non-blocking; primary alert is unaffected).
LLM_TIMEOUT=15

# OPTIONAL: Telegram alerts. Get a bot token from @BotFather.
# With just the token, the bot auto-discovers everyone who sends it /start and
# broadcasts alerts to all of them (Telegram only lets bots message users who
# messaged first, so people opt in via /start). Leave blank to disable Telegram.
TELEGRAM_BOT_TOKEN=
# OPTIONAL: also always alert your own chat, even before anyone subscribes.
# Get it from https://api.telegram.org/bot<TOKEN>/getUpdates after messaging your bot.
TELEGRAM_CHAT_ID=

# OPTIONAL: mirror logs to this file in addition to the console.
LOG_FILE=
